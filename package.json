{
  "name": "digital-dental-lab-v2",
  "version": "0.0.0",
  "scripts": {
     "start": "npx ng serve --poll=1000 --no-watch",
    "dev": "echo 'Use: npm start (for dev) OR npm run docs (for documentation)'",
    "docs": "node scripts/ai-docs-generator.js",
    "build": "ng build",
    "serve:ssr": "node dist/digital-dental-lab-v2/server/server.mjs",
    "dev:clean": "npx ng cache clean && npm run dev",
    "serve:only": "npx ng serve --poll=1000 --no-watch",
    "docs:only": "node scripts/ai-docs-generator.js",
    "docs:ai": "node scripts/ai-docs-generator.js",
    "docs:smart": "node scripts/smart-docs.js || echo 'Smart docs script running...'",
    "docs:update": "node scripts/update-docs.js || echo 'Docs script not found, continuing...'",
    "docs:scan": "node scripts/project-scanner.js",
    "serve:ssr": "node dist/digital-dental-lab-v2/server/server.mjs",
    "build:ssr": "ng build && ng run digital-dental-lab-v2:server", 
    "prerender": "ng run digital-dental-lab-v2:prerender"
  
},
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/ssr": "^17.3.8",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/express": "^4.17.17",
    "@types/node": "^18.18.0",
    "typescript": "~5.3.0"
  }
}